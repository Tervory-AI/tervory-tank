# Names only. Values live in your password manager and are pasted into Coolify's environment panel.
# Every provider account: pay-as-you-go, a hard monthly spend cap, auto-reload off or capped.

# PostgreSQL (the shared store; Tank creates the tank schema on first start)
POSTGRES_USER=tervory
POSTGRES_PASSWORD=
POSTGRES_DB=tervory

# Qdrant (vector store; used by Hermes and the semantic cache later)
QDRANT_API_KEY=

# LiteLLM (the model gateway inside Tank)
LITELLM_MASTER_KEY=

# Provider keys (API keys, never OAuth). OpenAI, Gemini and xAI carry the defaults (litellm/config.yaml); each falls back to the others. Anthropic is optional.
ANTHROPIC_API_KEY=      # console.anthropic.com
OPENAI_API_KEY=         # platform.openai.com
GEMINI_API_KEY=         # aistudio.google.com
XAI_API_KEY=            # console.x.ai
MISTRAL_API_KEY=        # console.mistral.ai (EU-hosted; the eu region's default)
DEEPSEEK_API_KEY=       # platform.deepseek.com (China-hosted: benchmarks on public data only until a client agrees)
OPENROUTER_API_KEY=     # openrouter.ai (trying new models before a direct key is worth it)
MOONSHOT_API_KEY=       # platform.moonshot.ai (Kimi; China-hosted: benchmarks on public data only until a client agrees)
PERPLEXITY_API_KEY=     # perplexity.ai/settings/api (Sonar: search-grounded research with citations; earmarked for Market Lab)

# Optional: Brave Search API key for Base pass 2 (website discovery). Without it, Base falls back to domain guesses.
BRAVE_API_KEY=

# The key the Workspace sends as X-Tank-Key. Agents do not use this.
TANK_API_KEY=

# Per-agent Tank keys. One long random string per box, pasted into Coolify only.
# Tank reads TANK_KEY_<AGENT>, hashes it (SHA-256), and stores the hash in tank.agent_keys.
# The agent box receives only its own key. Never log the value. Never commit it.
# The suffix lowercased is the agent id: TANK_KEY_TEMPLATE -> template, TANK_KEY_MARKET_LAB -> market_lab.
TANK_KEY_TEMPLATE=
# Tiger's key. Tank hashes it. Hermes compares the same value, or it will not recognise Tiger.
TANK_KEY_TIGER=

# Password for the agent's own database role (agent_<name>), not the Postgres superuser.
# Hex only, so it is safe inside a Postgres URL: openssl rand -hex 24
# The agent-roles service reads AGENT_DB_PASSWORD_<AGENT> and creates or updates the role.
# The agent resource gets the same value and nothing else from Postgres. Never log it. Never commit it.
# The suffix lowercased is the agent id: AGENT_DB_PASSWORD_TEMPLATE -> role agent_template.
AGENT_DB_PASSWORD_TEMPLATE=
# Password for role agent_tiger. Hex only: openssl rand -hex 24. Never commit the value.
AGENT_DB_PASSWORD_TIGER=

# Region tag written to every ledger row: us-east | za | eu
# The Boston stack is us-east. The South Africa stack (docker-compose.za.yml) sets za
# in the compose file itself. Do not point that stack at a US host.
TANK_REGION=us-east

# South Africa Tank only. Comma-separated LiteLLM model names that run in South Africa.
# Empty until za-local in litellm/config.za.yaml is filled in. Names only, never a key.
ZA_HOSTED_MODELS=
# Optional narrower allow-list. JSON object of tenant id to model names. No secrets.
# Example shape only: {"00000000-0000-0000-0000-000000000000":["za-local"]}
TANK_PROVIDER_ALLOW=
# Key name for the commented za-local slot. Value stays in Coolify.
ZA_LOCAL_API_KEY=
# Zenas room on THIS server. The /v1/zenas proxy refuses any other host.
ZENAS_AGENT_URL=http://agent-zenas:8000

# Workspace (served publicly by Coolify on port 3000)
# Clerk: dashboard.clerk.com -> Configure -> API keys. Organizations must be enabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Self-hosted search (SearXNG). Any long random string; internal only.
SEARXNG_SECRET=

# Market Lab feeds (C12). Names only. Paste values in Coolify, never in git.
# Free keys the founder creates. FRED is named because the brief calls for it;
# the runner does not store FRED series (the API terms forbid a database copy).
LEGISCAN_API_KEY=       # https://legiscan.com/legiscan  (public API, CC BY 4.0)
CENSUS_API_KEY=         # https://api.census.gov/data/key_signup.html
FRED_API_KEY=           # https://fred.stlouisfed.org/docs/api/api_key.html
EIA_API_KEY=            # https://www.eia.gov/opendata/register.php
NOAA_TOKEN=             # https://www.ncdc.noaa.gov/cdo-web/token  (NCEI). NWS alerts need none.
FEEDS_DATABASE_URL=     # sqlite file for the feeds runner, e.g. sqlite:///feeds.sqlite. Postgres: apply agents/market_lab/feeds/schema.sql with the platform tools.

# Comma-separated Clerk user ids allowed to open the founder console (/admin and /v1/admin). Anyone else gets a 404. Set the same value on Tank and the Workspace.
TERVORY_ADMIN_USER_IDS=

# Hermes (C7). Shared memory in the main stack. Internal only: no public domain.
# Hermes reads the same TANK_KEY_<AGENT> names as Tank and compares SHA-256 hashes. It does not read the database.
# Agents call Hermes at http://hermes:8000. They do not call Qdrant. QDRANT_API_KEY above is what Hermes uses on the main network.
# A later agent task attaches tervory-gw-<agent> to the hermes service and passes that agent's TANK_KEY_<AGENT> into it.
# The embedding model runs inside the Hermes container. No provider key. Client text stays on this server.
# The image already contains BAAI/bge-small-en-v1.5. Set this only to pin the same name.
HERMES_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Market Lab box (C9). Own corridor tervory-gw-market_lab, role agent_market_lab.
# Tank and Hermes both need TANK_KEY_MARKET_LAB. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
TANK_KEY_MARKET_LAB=
AGENT_DB_PASSWORD_MARKET_LAB=

# Radix (C10). Security auditor. Corridor tervory-gw-radix is an internal network
# (docker network create --internal tervory-gw-radix): Tank, Postgres, and Hermes only.
# TANK_KEY_RADIX goes on Tank and on Hermes. Hex password: openssl rand -hex 24.
# RADIX_ALLOWED_HOSTS stays empty. Radix refuses every other host until an egress proxy exists.
TANK_KEY_RADIX=
AGENT_DB_PASSWORD_RADIX=
RADIX_ALLOWED_HOSTS=

# Tisan (C10). Developer and designer. Corridor tervory-gw-tisan.
# TANK_KEY_TISAN goes on Tank and on Hermes. Hex password: openssl rand -hex 24.
TANK_KEY_TISAN=
AGENT_DB_PASSWORD_TISAN=

# Base room (B3). Own corridor tervory-gw-base, role agent_base.
# Tank and Hermes both need TANK_KEY_BASE. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
# Base reaches Tiger's browser and SearXNG on this corridor. It does not hold provider keys.
TANK_KEY_BASE=
AGENT_DB_PASSWORD_BASE=

# Zenas box (Z1). Own corridor tervory-gw-zenas, role agent_zenas.
# Tank and Hermes both need TANK_KEY_ZENAS. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
# ZENAS_PII_KEY encrypts personal identifiers in the Zenas box. Exactly 32 bytes, hex: openssl rand -hex 32.
TANK_KEY_ZENAS=
AGENT_DB_PASSWORD_ZENAS=
ZENAS_PII_KEY=
# Worked matters from our own released files. region shares them inside one region; tenant keeps them private.
# Decided cases are public and are matched either way. Nothing is copied to the other region.
ZENAS_MATTER_SHARING=region

# Zenas knowledge pool. Names only. Paste values in Coolify for the pool-loader, never in git.
# A keyed source is skipped until its variable is set. The value is never put in a URL, a log, or a test.
COURTLISTENER_API_TOKEN=   # https://www.courtlistener.com/help/api/rest/  (header Authorization: Token, not a query parameter)
GOVINFO_API_KEY=           # https://api.govinfo.gov/docs/  (header X-Api-Key). Optional: house.gov USLM is used when this is empty.
NY_OPENLEG_API_KEY=        # https://legislation.nysenate.gov/  New York Open Legislation. Not placed in a URL.
POOL_DISK_CAP_BYTES=       # optional byte cap for the pool on this box. Default 42949672960 (40 GiB).
COURTLISTENER_MIN_INTERVAL= # optional seconds between CourtListener calls. Default 1.
POOL_LOAD=                 # set to 1 only when starting pool-loader for one wave. Empty keeps the service idle.

# Rig (R3). Public API at rig.tervory.com. Corridor tervory-gw-rig, role agent_rig.
# Tank and Hermes both need TANK_KEY_RIG. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
TANK_KEY_RIG=
AGENT_DB_PASSWORD_RIG=
