# Names only. Values live in your password manager and are pasted into Coolify's environment panel.
# Every provider account: pay-as-you-go, a hard monthly spend cap, auto-reload off or capped.

# PostgreSQL (the shared store; Tank creates the tank schema on first start)
POSTGRES_USER=tervory
POSTGRES_PASSWORD=
POSTGRES_DB=tervory

# Qdrant (vector store; used by Hermes and the semantic cache later)
QDRANT_API_KEY=

# LiteLLM (the model gateway inside Tank)
LITELLM_MASTER_KEY=

# Provider keys (API keys, never OAuth). OpenAI, Gemini and xAI carry the defaults (litellm/config.yaml); each falls back to the others. Anthropic is optional.
ANTHROPIC_API_KEY=      # console.anthropic.com
OPENAI_API_KEY=         # platform.openai.com
GEMINI_API_KEY=         # aistudio.google.com
XAI_API_KEY=            # console.x.ai
MISTRAL_API_KEY=        # console.mistral.ai (EU-hosted; the eu region's default)
DEEPSEEK_API_KEY=       # platform.deepseek.com (China-hosted: benchmarks on public data only until a client agrees)
OPENROUTER_API_KEY=     # openrouter.ai (trying new models before a direct key is worth it)
MOONSHOT_API_KEY=       # platform.moonshot.ai (Kimi; China-hosted: benchmarks on public data only until a client agrees)
PERPLEXITY_API_KEY=     # perplexity.ai/settings/api (Sonar: search-grounded research with citations; earmarked for Market Lab)

# Optional: Brave Search API key for Base pass 2 (website discovery). Without it, Base falls back to domain guesses.
BRAVE_API_KEY=

# The key the Workspace sends as X-Tank-Key. Agents do not use this.
TANK_API_KEY=

# TRAIN-1: optional private dataset export; identifier checks apply in both regions.
HF_TOKEN=
HF_ORG=
# Dedicated header-only credential for the weekly re-test/nightly export jobs.
TRAINING_JOB_KEY=
# GitHub Actions configuration names: TRAINING_TANK_URL and TRAINING_TANK_URL_ZA (variables),
# TRAINING_JOB_KEY (secret). Use a credential-free HTTPS origin for the URL.

# Per-agent Tank keys. One long random string per box, pasted into Coolify only.
# Tank reads TANK_KEY_<AGENT>, hashes it (SHA-256), and stores the hash in tank.agent_keys.
# The agent box receives only its own key. Never log the value. Never commit it.
# The suffix lowercased is the agent id: TANK_KEY_TEMPLATE -> template, TANK_KEY_MARKET_LAB -> market_lab.
TANK_KEY_TEMPLATE=
# Tiger's key. Tank hashes it. Hermes compares the same value, or it will not recognise Tiger.
TANK_KEY_TIGER=

# Password for the agent's own database role (agent_<name>), not the Postgres superuser.
# Hex only, so it is safe inside a Postgres URL: openssl rand -hex 24
# The agent-roles service reads AGENT_DB_PASSWORD_<AGENT> and creates or updates the role.
# The agent resource gets the same value and nothing else from Postgres. Never log it. Never commit it.
# The suffix lowercased is the agent id: AGENT_DB_PASSWORD_TEMPLATE -> role agent_template.
AGENT_DB_PASSWORD_TEMPLATE=
# Password for role agent_tiger. Hex only: openssl rand -hex 24. Never commit the value.
AGENT_DB_PASSWORD_TIGER=

# Region tag written to every ledger row: us-east | za | eu
# The Boston stack is us-east. The South Africa stack (docker-compose.za.yml) sets za
# in the compose file itself. Do not point that stack at a US host.
TANK_REGION=us-east

# South Africa Tank only. Comma-separated LiteLLM model names that run in South Africa.
# Empty until za-local in litellm/config.za.yaml is filled in. Names only, never a key.
ZA_HOSTED_MODELS=
# Optional narrower allow-list. JSON object of tenant id to model names. No secrets.
# Example shape only: {"00000000-0000-0000-0000-000000000000":["za-local"]}
TANK_PROVIDER_ALLOW=
# Key name for the commented za-local slot. Value stays in Coolify.
ZA_LOCAL_API_KEY=
# Zenas room on THIS server. The /v1/zenas proxy refuses any other host.
ZENAS_AGENT_URL=http://agent-zenas:8000
# Per box. off (the default): a rule card that passes cite-check is active, and a
# memo goes to the matter with reviewed false. on: the review queue stays in front.
# Set it on the US box and the ZA box separately. No secret.
ZENAS_REVIEW=off
# How many decided cases one conversion reads. Default 200 when this is unset. Name only.
ZENAS_CONVERT_MAX=200
# Workspace only, founder home setting: the ZA Tank (HTTPS) and the ZA Tank's homes-only key
# (the value of TANK_HOMES_KEY on the ZA Tank; never the ZA TANK_API_KEY).
# Only a tenant id and a region code are sent. Names only here.
TANK_URL_ZA=
TANK_API_KEY_ZA=
# ZA Tank only: a key that can call POST /v1/zenas/tenants with home za and nothing else.
TANK_HOMES_KEY=

# Daily cap, in dollars, on paid shadow and search calls for one task type.
# Code skills are not capped. Default is 1 when this is unset.
TANK_SHADOW_BUDGET_USD=1

# Workspace (served publicly by Coolify on port 3000)
# Clerk: dashboard.clerk.com -> Configure -> API keys. Organizations must be enabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stripe billing. Workspace server only. Paste values in Coolify. Never commit a value.
# The browser does not receive the secret. Amounts on the billing page are read from Stripe.
# STRIPE_PLAN_PRICE_IDS is a comma-separated list of Price ids, in display order. No value here.
# BILLING_PUBLIC_ORIGIN is optional (https://app.tervory.com). Empty uses the request host for Checkout return links.
# STRIPE_WEBHOOK_SECRET verifies the Stripe webhook signature. Name only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLAN_PRICE_IDS=
BILLING_PUBLIC_ORIGIN=

# Claude connector (the mcp service, public at mcp.tervory.com). Names only.
# Create one Clerk OAuth application. Redirect URL: https://mcp.tervory.com/oauth/clerk/callback
# MCP_TOKEN_SIGNING_KEY: openssl rand -hex 32. Paste it in Coolify. Never commit it.
# CLERK_FRONTEND_API is optional when NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is set (it is a public host, not a secret).
# TERVORY_TENANT_ALIASES is the same list the Workspace uses: org_new=org_old,org_new2=org_old2
# Org ids are not secrets. An organization that is not listed maps to itself.
MCP_PUBLIC_URL=https://mcp.tervory.com
CLERK_FRONTEND_API=
CLERK_OAUTH_CLIENT_ID=
CLERK_OAUTH_CLIENT_SECRET=
MCP_TOKEN_SIGNING_KEY=
TERVORY_TENANT_ALIASES=

# Self-hosted search (SearXNG). Any long random string; internal only.
SEARXNG_SECRET=

# Market Lab feed keys. This is the list. Paste values in Coolify on the Market Lab
# resource (agents/market_lab/docker-compose.yml passes each name through). Never in git.
# A feed stays off until its variable is non-empty: it is not called, and status
# reads off / needs key. Nothing in the app asks for a key.
# FRED is read live and is not stored (the API terms forbid a database copy).
# NOAA_TOKEN is NCEI climate only. NWS weather alerts need no key.
LEGISCAN_API_KEY=       # https://legiscan.com/legiscan  (public API, CC BY 4.0)
CENSUS_API_KEY=         # https://api.census.gov/data/key_signup.html
FRED_API_KEY=           # https://fred.stlouisfed.org/docs/api/api_key.html
EIA_API_KEY=            # https://www.eia.gov/opendata/register.php
NOAA_TOKEN=             # https://www.ncdc.noaa.gov/cdo-web/token  (NCEI). NWS alerts need none.
FEEDS_DATABASE_URL=     # sqlite file for the feeds runner, e.g. sqlite:///feeds.sqlite. Postgres: apply agents/market_lab/feeds/schema.sql with the platform tools.

# Comma-separated Clerk user ids allowed to open the founder console (/admin and /v1/admin). Anyone else gets a 404. Set the same value on Tank and the Workspace.
TERVORY_ADMIN_USER_IDS=

# Hermes (C7). Shared memory in the main stack. Internal only: no public domain.
# Hermes reads the same TANK_KEY_<AGENT> names as Tank and compares SHA-256 hashes. It does not read the database.
# Agents call Hermes at http://hermes:8000. They do not call Qdrant. QDRANT_API_KEY above is what Hermes uses on the main network.
# A later agent task attaches tervory-gw-<agent> to the hermes service and passes that agent's TANK_KEY_<AGENT> into it.
# The embedding model runs inside the Hermes container. No provider key. Client text stays on this server.
# The image already contains BAAI/bge-small-en-v1.5. Set this only to pin the same name.
HERMES_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Market Lab box (C9). Own corridor tervory-gw-market_lab, role agent_market_lab.
# Tank and Hermes both need TANK_KEY_MARKET_LAB. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
TANK_KEY_MARKET_LAB=
AGENT_DB_PASSWORD_MARKET_LAB=

# Radix (C10). Security auditor. Corridor tervory-gw-radix is an internal network
# (docker network create --internal tervory-gw-radix): Tank, Postgres, and Hermes only.
# TANK_KEY_RADIX goes on Tank and on Hermes. Hex password: openssl rand -hex 24.
# RADIX_ALLOWED_HOSTS stays empty. Radix refuses every other host until an egress proxy exists.
TANK_KEY_RADIX=
AGENT_DB_PASSWORD_RADIX=
RADIX_ALLOWED_HOSTS=

# Tisan (C10). Developer and designer. Corridor tervory-gw-tisan.
# TANK_KEY_TISAN goes on Tank and on Hermes. Hex password: openssl rand -hex 24.
TANK_KEY_TISAN=
AGENT_DB_PASSWORD_TISAN=
# Tisan Figma reader (TS-2). Name only. The room has no route to the public
# internet, so it does not call Figma and does not read this value. The reader
# uses the recorded fixture for file ksi7ctRwEnN8wbip1yfuhL. Never commit a value.
FIGMA_TOKEN=

# Base room (B3). Own corridor tervory-gw-base, role agent_base.
# Tank and Hermes both need TANK_KEY_BASE. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
# Base reaches Tiger's browser and SearXNG on this corridor. It does not hold provider keys.
TANK_KEY_BASE=
AGENT_DB_PASSWORD_BASE=

# Zenas box (Z1). Own corridor tervory-gw-zenas, role agent_zenas.
# Tank and Hermes both need TANK_KEY_ZENAS. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
# ZENAS_PII_KEY encrypts personal identifiers in the Zenas box. Exactly 32 bytes, hex: openssl rand -hex 32.
TANK_KEY_ZENAS=
AGENT_DB_PASSWORD_ZENAS=
ZENAS_PII_KEY=
# Worked matters from a client's released files. region (the default) shares them with
# other tenants in the same region only. tenant keeps them private to the owner.
# Decided cases are public either way. Drafts and unreleased files are never shared.
# Nothing is copied to the other region.
ZENAS_MATTER_SHARING=region

# Zenas knowledge pool. Names only. Paste values in Coolify for the pool-loader, never in git.
# A keyed source is skipped until its variable is set. The value is never put in a URL, a log, or a test.
COURTLISTENER_API_TOKEN=   # https://www.courtlistener.com/help/api/rest/  (header Authorization: Token, not a query parameter)
GOVINFO_API_KEY=           # https://api.govinfo.gov/docs/  (header X-Api-Key). Optional: house.gov USLM is used when this is empty.
NY_OPENLEG_API_KEY=        # https://legislation.nysenate.gov/  New York Open Legislation. Not placed in a URL.
POOL_DISK_CAP_BYTES=       # optional byte cap for the pool on this box. Default 42949672960 (40 GiB).
COURTLISTENER_MIN_INTERVAL=12
COURTLISTENER_HOURLY_MAX=45
COURTLISTENER_DAILY_MAX=100
POOL_LOAD=                 # set to 1 only when starting pool-loader for one wave. Empty keeps the service idle.
LAWS_AFRICA_API_TOKEN=     # https://api.laws.africa/v3/  (header Authorization: Bearer). ZA box only. Never put it in a URL.
SAFLII_MIN_INTERVAL=       # optional seconds between SAFLII page fetches. Default 1. Live SAFLII load is deferred.
GOVZA_MAX_NOTICES=         # optional cap on gov.za notice pages per wave. Default 10. Keyless. ZA box only.
GOVZA_MIN_INTERVAL=        # optional seconds between gov.za fetches. Default 0. Use 1 on the ZA box.
CONCOURT_MIN_INTERVAL=     # seconds between Constitutional Court OAI/REST calls. Default 10.
CONCOURT_MAX_ITEMS=        # Latest Judgments items per wave. Default 5. Keyless.
ZA_CASE_MIN_INTERVAL=      # seconds between other keyless ZA case fetches. Default 1.
ZA_CASE_MAX_DOCS=          # documents per keyless ZA case source per wave. Default 8.
SCA_MAX_YEARS=             # SCA and Electoral Court year folders per wave. Default 1.
SCA_MAX_PAGES=             # jDownloads pages per year (?start= steps of 10). Default 1.

# Rig (R3). Public API at rig.tervory.com. Corridor tervory-gw-rig, role agent_rig.
# Tank and Hermes both need TANK_KEY_RIG. Without it on Hermes, Hermes does not recognise this agent.
# Hex password: openssl rand -hex 24. Paste the values in Coolify only. Never commit them.
TANK_KEY_RIG=
AGENT_DB_PASSWORD_RIG=
# Days of finished searches Rig reuses, and how long a saved search is kept.
# Empty means 90. The nightly clean-up uses the same number.
RIG_SEARCH_RECALL_DAYS=

# RX-5 optional source credentials, read by name in Tank. No outbound lookup.
# Leave unset: keyed evidence is skipped. These names do not enable a vault.
RADIX_SOURCE_CIPC_KEY=
RADIX_SOURCE_REGISTER_KEY=

# WORKERS-1. Names only. Paste values in Coolify on the workers app. Never commit a key.
# Boston starts at one task, 2 CPU, 4 GB, 90 minutes. The third server raises the
# numbers in Coolify (3 tasks, 4 CPU, 8 GB) and sets WORKER_LINK=wireguard. No code change.
# Do not set TANK_REGION=za on this app. Workers do not run on the ZA server.
WORKER_MAX_TASKS=1
WORKER_TASK_CPUS=2
WORKER_TASK_MEMORY=4g
WORKER_TASK_TIMEOUT_MINUTES=90
WORKER_SERVICE_MEMORY=6g
WORKER_SERVICE_CPUS=3
WORKER_LINK=internal
WORKER_POLL_SECONDS=60
WORKER_REPO=Tervory-AI/tervory-tank
WORKER_TENANT_ID=00000000-0000-0000-0000-000000000001
WORKER_TASK_TYPE=reason.brief
TANK_URL=http://tank:8000
# Docker network the Tank service is already on. On the third server, a network that routes over WireGuard.
TANK_DOCKER_NETWORK=
# Same value on Tank (so the ledger agent is "workers") and on this app. openssl rand -hex 32
TANK_KEY_WORKERS=
# GitHub App (Tervory Workers Bot). Set all three in Coolify on the workers app.
# GITHUB_APP_PRIVATE_KEY is the multiline PEM, pasted as a Coolify setting. No host file.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional, for a run outside Coolify: a key file path. When set it wins over GITHUB_APP_PRIVATE_KEY.
# The workers compose does not pass it. Leave it unset on the workers app.
GITHUB_APP_PRIVATE_KEY_FILE=
# Tank reads the Workers panel from http://workers:8000 on Tank's network. Override only off Docker.
WORKERS_URL=

# Maximum automatic gold candidates per source per night (default 200).
GOLD_AUTO_MAX=

# Maximum estimated HF training cost per job, USD (default 50).
HF_TRAIN_MAX_USD=

# Base company-data trial credential; set only in the Base room.
CONTEXT_DEV_API_KEY=
# Base trial credit ceiling per run (default 500).
CONTEXT_DEV_MAX_CREDITS=

# CORE-1 daily platform bench limit in USD; defaults to 5. Set 0 to pause.
TANK_BENCH_MAX_USD=
