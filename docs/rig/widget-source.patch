+import { openThreeD } from "./loader";
+import { ThreeClient } from "./client";
+import type { BuildRequest } from "./types";
+import type { ViewerContext } from "./frame";
+export function mount(host: HTMLElement, base: string, key: string, build: BuildRequest,
