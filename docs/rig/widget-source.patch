+function deliveryRange(value: CartLine["delivery"]): string {
+  if (value.min_days !== undefined && value.max_days !== undefined) return `Delivery: ${value.min_days}–${value.max_days} business days`;
+  if (value.ship_days !== undefined) return `Delivery: ${value.ship_days} business days`;
+  return value.eta ? `Delivery: ${value.eta}` : "";
+}
