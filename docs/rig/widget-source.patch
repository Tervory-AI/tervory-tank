+  return openThreeD(host, new ThreeClient(base, key), build, kiosk, context);
+}
diff --git a/widget/src/ui/cart-controller.ts b/widget/src/ui/cart-controller.ts
new file mode 100644
index 0000000..f10e610
--- /dev/null
+++ b/widget/src/ui/cart-controller.ts
@@ -0,0 +1,89 @@
+import { lineProjection, orderProjection, renderCart, type CartView } from "./cart";
+type Request = (operation: string, data: Record<string, unknown>) => Promise<Record<string, unknown>>;
+export class CartController {
+  enabled = false;
+  view: CartView = { store: "", screen: "search", lines: [], product: null, order: null, busy: false, now: 0 };
+  private session = "";
+  private timer = 0;
+  private polling = false;
+  private generation = 0;
+  constructor(private request: Request, private changed: () => void, private storageKey: string) {}
+  async start(): Promise<void> {
+    const generation = this.generation;
+    try {
+      const result = await this.request("session", {});
+      if (generation !== this.generation) return;
+      if (result.mode !== "cart" || typeof result.session !== "string") return;
+      this.enabled = true; this.view.store = typeof result.store_name === "string" ? result.store_name : "";
+      try { this.session = sessionStorage.getItem(this.storageKey) || result.session; sessionStorage.setItem(this.storageKey, this.session); } catch { this.session = result.session; }
+      await this.read();
+      if (generation !== this.generation) return;
+      this.timer = window.setInterval(() => { this.view.now = Date.now(); if (this.view.order && !this.view.order.payment_confirmed) void this.poll(); }, 1000);
+    } catch { /* Quote stores have no cart session; their rendering stays unchanged. */ }
+  }
+  stop(): void { window.clearInterval(this.timer); this.generation++; }
+  render(): string { return this.enabled ? renderCart(this.view) : ""; }
+  private call(operation: string, data: Record<string, unknown> = {}): Promise<Record<string, unknown>> { return this.request(operation, { session: this.session, ...data }); }
+  private lines(result: Record<string, unknown>): void { this.view.lines = Array.isArray(result.lines) ? result.lines.map(value => lineProjection(value)) : []; }
+  async read(): Promise<void> {
+    const result = await this.call("view"); this.lines(result);
+    if (typeof result.checkout_id === "string") { this.view.order = orderProjection(await this.call("order", { checkout_id: result.checkout_id })); await this.poll(); }
+    this.changed();
+  }
+  async preview(id: string): Promise<void> {
+    const generation = ++this.generation; this.view.busy = true;
+    try { const result = await this.call("view", { product_id: id }); if (generation !== this.generation) return; this.lines(result); this.view.product = lineProjection(result.product as Record<string, unknown>); this.view.screen = "product"; }
+    catch { if (generation === this.generation) this.view.screen = "error"; }
+    finally { if (generation === this.generation) { this.view.busy = false; this.changed(); } }
+  }
+  async poll(): Promise<void> {
+    if (!this.view.order || this.polling) return;
+    this.polling = true;
+    try {
+      this.view.order = orderProjection(await this.call("order", { checkout_id: this.view.order.id }));
+      if (this.view.order.payment_confirmed) this.view.screen = "paid";
+      else if (this.view.order.state === "expired") {
+        this.view.screen = "rechecking"; this.changed();
+        const result = await this.call("view", { recheck: true }); this.lines(result);
+        this.view.screen = result.recheck_state === "changed" ? "changed" : result.recheck_state === "unavailable" ? "unavailable" : "unchanged"; this.view.order = null;
+      } else if (["pending", "cancel_unknown"].includes(this.view.order.state) && this.view.screen !== "cart") this.view.screen = "return";
+      this.changed();
+    } catch { /* Retain the server's last verified state; never assert payment or cancellation locally. */ }
+    finally { this.polling = false; }
+  }
+  async quantity(id: string, quantity: number): Promise<void> {
+    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 100 || this.view.busy) return;
+    const line = this.view.lines.find(value => value.id === id); if (!line) return;
+    await this.run(async () => {
+      this.lines(await this.call("add", { line_id: id, product_id: line.product_id, quantity, back_order: line.kind === "back_order" }));
+    });
+  }
+  private async run(work: () => Promise<void>): Promise<void> {
+    if (this.view.busy) return;
+    this.view.busy = true; this.changed();
+    try { await work(); } catch { this.view.screen = "error"; } finally { this.view.busy = false; this.changed(); }
+  }
+  async action(action: string, id = ""): Promise<void> {
+    if (!this.enabled) return;
+    if (action === "shop" || action === "handoff" || action === "view") { this.view.screen = action === "shop" ? "search" : action === "handoff" ? "handoff" : "cart"; this.changed(); return; }
+    const popup = action === "checkout" && !this.view.busy ? window.open("about:blank", "_blank") : null;
+    if (popup) popup.opener = null;
+    await this.run(async () => {
+      if (action === "add" && this.view.product) {
+        const product = this.view.product;
+        this.lines(await this.call("add", { product_id: product.product_id, quantity: 1, back_order: product.kind === "back_order" }));
+        this.view.product = this.view.lines.find(line => line.product_id === product.product_id) || null; this.view.screen = "added";
+      } else if (action === "remove") { this.lines(await this.call("remove", { line_id: id })); this.view.screen = "cart"; }
+      else if (action === "backorder") {
+        const line = this.view.lines.find(value => value.id === id); if (!line) return;
+        this.lines(await this.call("add", { line_id: id, product_id: line.product_id, quantity: line.quantity, back_order: true }));
+        this.view.screen = this.view.lines.some(value => value.unavailable) ? "unavailable" : "cart";
+      } else if (action === "checkout") {
+        const result = orderProjection(await this.call("checkout")); this.view.order = { ...result, lines: this.view.lines };
+        if (!result.checkout_url || result.state !== "pending") { this.view.screen = "error"; popup?.close(); return; }
+        this.view.screen = "return"; if (popup) popup.location.replace(result.checkout_url); else window.location.assign(result.checkout_url);
+      }
+    });
+    if (this.view.screen === "error") popup?.close();
+  }
+}
diff --git a/widget/src/ui/cart.ts b/widget/src/ui/cart.ts
new file mode 100644
index 0000000..7e15dcf
--- /dev/null
+++ b/widget/src/ui/cart.ts
@@ -0,0 +1,75 @@
+/** Approved Rig cart copy and public-only wire projections. No quote-store changes. */
+export type CartLine = { id: string; product_id: string; title: string; quantity: number; price: string; currency: string; kind: string; delivery: { min_days?: number; max_days?: number; ship_days?: number; eta?: string; status?: string }; unavailable?: boolean; previous?: { price: string; delivery: CartLine["delivery"] } };
+export type CartOrder = { id: string; state: string; expires_at: string; checkout_url?: string; payment_confirmed?: boolean; late_payment?: boolean; number?: string; total?: string; currency?: string; lines: CartLine[] };
+export type CartScreen = "search" | "product" | "added" | "cart" | "handoff" | "return" | "rechecking" | "changed" | "unchanged" | "unavailable" | "paid" | "error";
+export type CartView = { store: string; screen: CartScreen; lines: CartLine[]; product: CartLine | null; order: CartOrder | null; busy: boolean; now: number };
+const esc = (v: unknown) => String(v ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
+export const price = (v: string | number, currency: string) => new Intl.NumberFormat("en-US", { style: "currency", currency }).format(Number(v));
+const total = (lines: CartLine[]) => lines.reduce((sum, line) => sum + Math.round(Number(line.price) * 100) * line.quantity, 0) / 100;
+function projectedDelivery(raw: Record<string, unknown>): CartLine["delivery"] {
+  return Object.fromEntries(Object.entries(raw).filter(([k, v]) => ["min_days", "max_days", "ship_days"].includes(k) ? typeof v === "number" && Number.isFinite(v) : ["eta", "status"].includes(k) && typeof v === "string"));
+}
+export function lineProjection(raw: Record<string, unknown>): CartLine {
+  const delivery = projectedDelivery((raw.delivery || {}) as Record<string, unknown>);
+  const line: CartLine = { id: String(raw.id), product_id: String(raw.product_id), title: String(raw.title), quantity: Number(raw.quantity), price: String(raw.price), currency: String(raw.currency), kind: String(raw.kind), delivery };
+  if (raw.unavailable === true) line.unavailable = true;
+  if (raw.previous && typeof raw.previous === "object") { const previous = raw.previous as Record<string, unknown>; line.previous = { price: String(previous.price), delivery: projectedDelivery((previous.delivery || {}) as Record<string, unknown>) }; }
+  return line;
+}
+export function orderProjection(raw: Record<string, unknown>): CartOrder {
+  const order: CartOrder = { id: String(raw.id), state: String(raw.state), expires_at: String(raw.expires_at), lines: Array.isArray(raw.lines) ? raw.lines.map(line => lineProjection(line)) : [] };
+  for (const key of ["number", "total", "currency"] as const) if (typeof raw[key] === "string") order[key] = raw[key];
+  if (typeof raw.checkout_url === "string") { const url = new URL(raw.checkout_url); if (url.protocol === "https:" && !url.username && !url.password) order.checkout_url = url.href; }
+  order.payment_confirmed = raw.payment_confirmed === true;
+  order.late_payment = raw.late_payment === true;
+  return order;
+}
+export function deliveryText(line: CartLine): string {
+  if (line.unavailable) return "No longer available. Back order it or remove it.";
+  if (line.kind === "back_order") return "Back order · Delivery date not confirmed";
+  return deliveryRange(line.delivery);
+}
+function deliveryRange(value: CartLine["delivery"]): string {
+  if (value.min_days !== undefined && value.max_days !== undefined) return `Delivery: ${value.min_days}–${value.max_days} business days`;
+  if (value.ship_days !== undefined) return `Delivery: ${value.ship_days} business days`;
+  return value.eta ? `Delivery: ${value.eta}` : "";
+}
+const button = (label: string, action: string, secondary = false, disabled = false, id = "") => `<button type="button" class="cart-btn${secondary ? " cart-secondary" : ""}" data-action="cart-${action}" data-id="${esc(id)}"${disabled ? " disabled" : ""}>${esc(label)}</button>`;
+const notice = (title: string, text: string) => `<div class="cart-notice" role="status"><strong>${esc(title)}</strong>${text ? `<p>${esc(text)}</p>` : ""}</div>`;
+function lineCard(line: CartLine, editable = false, paid = false, busy = false): string {
+  let body = `<div class="cart-product"><h2>${esc(line.title)}</h2><p class="cart-code">${esc(line.product_id)}</p>`;
+  if (!paid) body += `<p class="cart-price">${esc(price(line.price, line.currency))}</p>`;
+  if (line.previous) body += `<div class="cart-change">${line.previous.price !== line.price ? `<p>Price changed: ${esc(price(line.previous.price, line.currency))} → ${esc(price(line.price, line.currency))}.</p>` : ""}${JSON.stringify(line.previous.delivery) !== JSON.stringify(line.delivery) ? `<p>Delivery changed: ${esc(deliveryRange(line.previous.delivery).replace("Delivery: ", "").replace(" business days", ""))} → ${esc(deliveryRange(line.delivery).replace("Delivery: ", ""))}.</p>` : ""}</div>`;
+  if (paid) body += `<p class="cart-line-total">${line.quantity} × ${esc(price(line.price, line.currency))} each<br>Line total: ${esc(price(Number(line.price) * line.quantity, line.currency))}</p>`;
+  body += `<p>${esc(deliveryText(line))}</p></div>`;
+  if (editable) body += `<div class="cart-details"><label class="cart-quantity">Quantity<input type="number" min="1" max="100" step="1" value="${line.quantity}" id="cart-quantity-${esc(line.id)}" data-cart-quantity="${esc(line.id)}"${busy ? " disabled" : ""}></label><p class="cart-line-total">Line total: ${esc(price(Number(line.price) * line.quantity, line.currency))}</p><div class="cart-actions">${line.unavailable ? button("Back order", "backorder", false, busy, line.id) : ""}${button(line.unavailable ? "Remove item" : "Remove", "remove", true, busy, line.id)}</div></div>`;
+  return `<article class="cart-card${editable ? " cart-line" : ""}" data-line="${esc(line.id)}">${body}</article>`;
+}
+export function renderCart(view: CartView): string {
+  const { screen, lines, product, order, busy } = view;
+  if (screen === "search") return "";
+  const heading = screen === "product" ? "FIND A PRODUCT" : screen === "added" ? "ITEM ADDED TO CART" : screen === "handoff" ? "GOING TO STORE CHECKOUT" : screen === "return" || screen === "error" ? "STORE CHECKOUT" : screen === "paid" ? "ORDER RECEIVED" : "YOUR CART";
+  let body: string;
+  if (screen === "product" && product) body = `${lineCard(product)}${product.kind === "back_order" ? notice("", "No delivery date is available. You can back order this item or remove it.") : ""}<div class="cart-actions">${button(product.kind === "back_order" ? "Back order" : "Add to cart", "add", false, busy)}${product.kind === "back_order" ? button("Remove item", "shop", true) : ""}</div>`;
+  else if (screen === "added" && product) body = `${notice("Item added", "The item is in the Rig cart on this store’s site.")}${lineCard(product)}<p>Quantity: ${product.quantity} · Cart total: ${esc(price(total(lines), product.currency))}</p><div class="cart-actions">${button("View cart", "view")}${button("Keep shopping", "shop", true)}</div>`;
+  else if (screen === "handoff") body = `<div class="cart-card cart-window"><h2>PAYMENT WINDOW</h2><p class="cart-duration">5 minutes</p><p>You’re going to ${esc(view.store)}’s own checkout. The 5-minute window starts there. This store’s shop platform takes payment; Rig never does.</p><p>When the window ends, prices and stock must be checked again before checkout can continue.</p><div class="cart-actions">${button("Continue to store checkout", "checkout", false, busy)}${button("Back to cart", "view", true)}</div></div>`;
+  else if (screen === "error") body = `<div class="cart-card cart-window"><h2>This store’s checkout is unavailable</h2><strong>Your cart is saved</strong><p>We could not open this store’s checkout. You can try again or return to your cart.</p><p>Prices and stock will be checked again before the next checkout. The 5-minute window has not started.</p><div class="cart-actions">${button("Try again", "checkout", false, busy)}${button("Back to cart", "view", true)}</div></div>`;
+  else if (screen === "return" && order) {
