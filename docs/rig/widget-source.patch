+/** Approved 06/07 layout. Product imagery and names are always API supplied. */
+export type ViewerContext = {
+  storeName?: string; productName?: string; finePrint?: string;
+  back?: () => void; menu?: () => void; quote?: () => void;
+};
+
+export function element<K extends keyof HTMLElementTagNameMap>(tag: K, text = ""): HTMLElementTagNameMap[K] {
+  const n = document.createElement(tag); n.textContent = text; return n;
+}
+
+export function createFrame(host: HTMLElement, kiosk: boolean, context: ViewerContext = {}) {
+  host.replaceChildren();
+  const root = element("section"); root.className = "rig-3d" + (kiosk ? " kiosk" : "");
+  root.setAttribute("aria-label", "3D product view"); host.append(root);
+  const style = element("style"); style.textContent = frameStyles; root.append(style);
+  const header = element("header"); header.className = "rig-3d-header";
+  header.append(element("strong", context.storeName || ""));
+  const nav = element("nav"); nav.setAttribute("aria-label", "Rig");
+  nav.append(element("span", "Rig"));
+  const menu = element("button"); menu.innerHTML = '<svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="3"/></svg>'; menu.type = "button"; menu.className = "menu";
+  menu.setAttribute("aria-label", "Open Rig menu"); menu.addEventListener("click", () => context.menu?.());
+  // Host navigation is reused, never invent public links to private admin routes.
+  menu.hidden = !context.menu; nav.append(menu); header.append(nav); root.append(header);
+  const body = element("div"); body.className = "rig-3d-body"; root.append(body);
+  body.append(element("h1", kiosk ? "Dealership terminal" : "3D product view"));
+  const subtitle = element("h2", "Explore this setup"); body.append(subtitle);
+  const layout = element("div"); layout.className = "rig-3d-layout"; body.append(layout);
+  const visual = element("div"); visual.className = "rig-3d-visual"; layout.append(visual);
+  const viewport = element("div"); viewport.className = "rig-3d-viewport"; visual.append(viewport);
+  const canvas = element("canvas"); canvas.tabIndex = 0;
+  canvas.setAttribute("aria-label", "Rotate with left and right arrows. Zoom with plus and minus."); viewport.append(canvas);
+  const placeholder = element("div"); placeholder.className = "rig-3d-placeholder";
+  const stateText = element("p"); stateText.setAttribute("role", "status"); placeholder.append(stateText); viewport.append(placeholder);
+  const spacer = element("div"); spacer.className = "rig-3d-spacer"; spacer.setAttribute("aria-hidden", "true"); visual.append(spacer);
+  const controls = element("div"); controls.className = "controls"; visual.append(controls);
+  for (const text of ["Rotate left", "Rotate right", "Zoom in", "Zoom out", "Exploded view", "Back to setups"]) {
+    const button = element("button", text); button.type = "button"; button.disabled = true; controls.append(button);
+  }
+  const status = element("p"); status.className = "status"; status.hidden = true; status.setAttribute("role", "status"); visual.append(status);
+  const side = element("aside"); side.className = "rig-3d-side"; layout.append(side);
+  const summary = element("div"); summary.className = "rig-3d-summary";
+  summary.append(element("h2", "Your setup"));
+  const product = element("strong", context.productName || ""); summary.append(product);
+  const parts = element("div"); parts.className = "parts"; summary.append(parts);
+  const swaps = element("div"); swaps.className = "swaps"; summary.append(swaps);
+  const total = element("h2", "Indicative total: —"); summary.append(total);
+  const fine = element("p", context.finePrint || ""); fine.className = "fine"; fine.hidden = !fine.textContent; summary.append(fine);
+  const request = element("button", "Request a quote"); request.type = "button"; request.className = "quote-button"; summary.append(request);
+  side.append(summary);
+  const contact = element("div"); contact.className = "contact"; contact.hidden = true; side.append(contact);
+  function message(value: string) { status.textContent = value; status.hidden = !value; }
+  function state(value: "loading" | "ready" | "error" | "photos" | "empty", photo = "") {
+    root.dataset.state = value; canvas.hidden = value !== "ready"; placeholder.hidden = value === "ready";
+    stateText.textContent = value === "loading" ? "Loading product view…" : value === "empty" ? "Choose a product to explore in 3D."
+      : value === "error" ? "The 3D view could not load. Please use the product photos." : "Photos are available for this product.";
+    placeholder.querySelectorAll("img,button,.skeleton").forEach(n => n.remove());
+    if (value === "loading") for (let i = 0; i < 3; i++) { const n = element("div"); n.className = "skeleton"; placeholder.append(n); }
+    if (photo && ["error", "photos"].includes(value)) {
+      const image = element("img"); image.src = photo; image.alt = "Product photo"; placeholder.append(image);
+    }
+    if (["empty", "error"].includes(value)) {
+      const back = element("button", "Back to setups"); back.type = "button"; back.className = "quote-button";
+      back.addEventListener("click", () => context.back?.()); placeholder.append(back);
+    }
+    controls.querySelectorAll("button").forEach(n => { n.disabled = value !== "ready"; });
+    request.disabled = value !== "ready";
+  }
+  return { root, canvas, controls, status, total, swaps, side, summary, contact, parts, product, subtitle, request, viewport,
+    context, state, message };
+}
+
+export const frameStyles = `
+.rig-3d{--rig-card:#fff;--rig-3d-canvas:#f2efe7;box-sizing:border-box;width:100%;margin:0;color:#242722;background:var(--rig-3d-canvas);font:14px/24px Inter,Arial,sans-serif}
