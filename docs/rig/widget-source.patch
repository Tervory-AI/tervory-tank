+  else if (screen === "handoff") body = `<div class="cart-card cart-window"><h2>PAYMENT WINDOW</h2><p class="cart-duration">5 minutes</p><p>You’re going to ${esc(view.store)}’s own checkout. The 5-minute window starts there. This store’s shop platform takes payment; Rig never does.</p><p>When the window ends, prices and stock must be checked again before checkout can continue.</p><div class="cart-actions">${button("Continue to store checkout", "checkout", false, busy)}${button("Back to cart", "view", true)}</div></div>`;
+  else if (screen === "error") body = `<div class="cart-card cart-window"><h2>This store’s checkout is unavailable</h2><strong>Your cart is saved</strong><p>We could not open this store’s checkout. You can try again or return to your cart.</p><p>Prices and stock will be checked again before the next checkout. The 5-minute window has not started.</p><div class="cart-actions">${button("Try again", "checkout", false, busy)}${button("Back to cart", "view", true)}</div></div>`;
