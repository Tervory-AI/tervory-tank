+/** Approved Rig cart copy and public-only wire projections. No quote-store changes. */
+export type CartLine = { id: string; product_id: string; title: string; quantity: number; price: string; currency: string; kind: string; delivery: { min_days?: number; max_days?: number; ship_days?: number; eta?: string; status?: string }; unavailable?: boolean; previous?: { price: string; delivery: CartLine["delivery"] } };
