@@ -0,0 +1,16 @@
+import { expect, it } from "vitest";
+import { lineProjection, orderProjection, renderCart, type CartView } from "../widget/src/ui/cart";
+import { neutral } from "../widget/src/theme/themes";
+import { renderView, type View } from "../widget/src/ui/render";
+const line = lineProjection({ id: "placeholder-line", product_id: "placeholder-sku", title: "placeholder product", quantity: 2, price: "12.00", currency: "USD", kind: "stock", delivery: { min_days: 2, max_days: 3 }, source: { name: "placeholder-private-source", url: "https://placeholder-private.example", cost: "9.00" } });
+const view = (screen: CartView["screen"]): CartView => ({ store: "placeholder store", screen, lines: [line], product: line, order: null, busy: false, now: Date.parse("2026-11-03T12:00:00Z") });
+it("empty cart uses no fixture products", () => { const state = view("cart"); state.lines = []; expect(renderCart(state)).toContain("Your cart is empty"); expect(renderCart(state)).not.toContain("placeholder product"); });
+it("added state uses server quantity and price", () => expect(renderCart(view("added"))).toContain("Quantity: 2 · Cart total: $24.00"));
+it("price change requires review", () => { const state = view("changed"); state.lines = [{ ...line, price: "13.00", previous: { price: "12.00", delivery: line.delivery } }]; expect(renderCart(state)).toContain("Price changed: $12.00 → $13.00."); });
+it("unavailable choice disables checkout", () => { const state = view("unavailable"); state.lines = [{ ...line, unavailable: true }]; expect(renderCart(state)).toMatch(/data-action="cart-handoff"[^>]* disabled/); });
+it("expired copy confirms server cancellation", () => expect(renderCart(view("rechecking"))).toContain("The unpaid store order was cancelled."));
+it.each([false, true])("paid/late order: %s", late => { const state = view("paid"); state.order = orderProjection({ id: "placeholder-checkout", state: "placed", expires_at: "2026-11-03T12:05:00Z", payment_confirmed: true, late_payment: late, total: "24.00", currency: "USD", number: "placeholder-order", lines: [line] }); expect(renderCart(state)).toContain(late ? "Payment received after the window" : "Payment confirmed"); expect(renderCart(state)).toContain("Total paid: $24.00"); });
+it("time left comes from server expires_at", () => { const state = view("return"); state.order = orderProjection({ id: "placeholder-checkout", state: "pending", expires_at: "2026-11-03T12:02:00Z" }); expect(renderCart(state)).toContain("02:00"); state.now += 31000; expect(renderCart(state)).toContain("01:29"); });
+it("checkout unavailable uses approved copy", () => expect(renderCart(view("error"))).toContain("The 5-minute window has not started."));
+it("supplier fields never enter state", () => { expect(JSON.stringify(line)).not.toMatch(/private|source|cost|https:/); });
+it("quote output remains independent", () => { const state = { theme: neutral, screen: "home", query: "", results: [], selectedId: null, product: null, setups: [], activeTier: null, graph: null, expanded: [], swap: null, askQuestion: "", askAnswer: null, askCites: "", linkUrl: "", linkRequestId: null, linkError: null, quote: null, message: null, customizedTiers: [] } as View; expect(renderCart(view("search"))).toBe(""); expect(renderView(state)).not.toContain("cart-"); });
