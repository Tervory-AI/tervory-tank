+.rig-3d h1{font:600 36px/44px Inter,Arial,sans-serif;height:24px}.rig-3d h2{font:600 20px/24px Inter,Arial,sans-serif}
+.rig-3d-header{display:flex;align-items:center;gap:16px;padding:32px;background:#fff}.rig-3d-header>strong{flex:1;min-width:0;font-size:24px;font-weight:600}
+.rig-3d-header nav{width:160px;display:flex;align-items:center;justify-content:space-between;padding:0 16px;height:64px;color:#001840;font-size:20px}
+.rig-3d-header .menu{width:44px;min-height:44px;height:44px;padding:0;border:0;font:24px/1 Inter,Arial,sans-serif}
+.rig-3d-body{display:flex;flex-direction:column;gap:24px;padding:48px}.rig-3d-layout{display:grid;grid-template-columns:minmax(0,1fr) 360px;align-items:start;gap:24px}
+.rig-3d-visual{display:flex;flex-direction:column;gap:16px;min-width:0}.rig-3d-viewport{height:300px;background:#fff;border:1px solid #d5d0c3;border-radius:8px;overflow:hidden;position:relative}
+.rig-3d canvas{display:block;width:100%;height:100%;touch-action:none}.rig-3d-placeholder{padding:24px;display:flex;flex-direction:column;gap:16px;height:100%;overflow:auto}.rig-3d-placeholder>p{font-size:20px;font-weight:600}
+.rig-3d-placeholder img{max-width:100%;object-fit:contain;min-height:0}.rig-3d .skeleton{background:#e8e4da;min-height:48px}.rig-3d-spacer{height:24px}
+.rig-3d .controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 8px}.rig-3d button{font:600 14px/24px Inter,Arial,sans-serif;color:#001840;background:#fff;border:1px solid #001840;border-radius:8px;min-width:0;min-height:48px;padding:11px 16px;cursor:pointer}
+.rig-3d button:disabled{color:#242722;background:#e8e4da;cursor:not-allowed;opacity:1}.rig-3d button:focus-visible,.rig-3d input:focus-visible,.rig-3d select:focus-visible,.rig-3d canvas:focus-visible{outline:3px solid #001840;outline-offset:3px}
+.rig-3d .quote-button{background:#001840;color:#fff;border:0}.rig-3d .quote-button:disabled{background:#e8e4da;color:#242722}
+.rig-3d-side{background:#fff;border-radius:8px;padding:24px;min-width:0}.rig-3d-summary,.rig-3d .contact,.rig-3d .contact form,.rig-3d .parts,.rig-3d .swaps{display:flex;flex-direction:column;gap:16px}
+.rig-3d-summary>strong{font-size:16px;font-weight:600}.rig-3d .fine,.rig-3d .contact-help{color:#686b60;font:14px/24px Inter,Arial,sans-serif}.rig-3d .status:empty{display:none}
+.rig-3d .field{border:1px solid #8b919a;border-radius:8px;padding:16px;display:flex;flex-direction:column;gap:8px;height:88px;color:#3d4a66;font:14px/24px Inter,Arial,sans-serif}
+.rig-3d input{border:0;background:#fff;color:#001840;font:14px/24px Inter,Arial,sans-serif;width:100%;min-width:0;padding:0;min-height:24px}
+.rig-3d .swaps select{width:100%;min-height:48px;background:#fff;color:#001840;border:1px solid #8b919a;border-radius:8px;font:14px/24px Inter,Arial,sans-serif;padding:8px}
+.rig-3d.kiosk{min-height:100vh}.rig-3d.kiosk button{min-height:64px;font-size:16px}.rig-3d.kiosk .menu{min-height:44px}.rig-3d.kiosk .rig-3d-viewport{height:320px}
+.rig-3d:fullscreen{overflow:auto;max-width:none;width:100%;height:100%}.rig-3d .terminal-actions{display:flex;flex-direction:column;gap:16px;margin-top:16px}
