# Configuration automation only; no Zitadel source is copied or modified.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS configure
WORKDIR /app
RUN pip install --no-cache-dir httpx==0.28.1 PyJWT==2.15.1 cryptography==50.0.2
COPY ops/identity/setup.py /app/setup.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "/app/setup.py"]

# Same encrypted backup worker source/recipe as jobs/train/Dockerfile.backup,
# with an exact base digest for the independent identity resource.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159 AS backup
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client age \
    && pip install --no-cache-dir httpx==0.28.1 \
    && rm -rf /var/lib/apt/lists/* && useradd --create-home --uid 1000 backup-worker
COPY --chown=backup-worker:backup-worker agents/_chassis/chassis/__init__.py agents/_chassis/chassis/storage.py /app/agents/_chassis/chassis/
COPY --chown=backup-worker:backup-worker jobs/train/backup.py jobs/train/r2_archive.py /app/jobs/train/
USER backup-worker
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "jobs/train/backup.py", "--owner", "zenas", "--target", "database", "--identity", "--nightly"]
