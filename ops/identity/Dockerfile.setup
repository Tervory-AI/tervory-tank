# Configuration automation only; no Zitadel source is copied or modified.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
WORKDIR /app
RUN pip install --no-cache-dir httpx==0.28.1 PyJWT==2.15.1 cryptography==50.0.2
COPY ops/identity/setup.py /app/setup.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "/app/setup.py"]
