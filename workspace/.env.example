# Names only; values live in Doppler and are pasted into Coolify's environment panel.

# Where Tank is reachable from the Workspace container. On the same Coolify server use the compose service name.
TANK_URL=http://tank:8000
# The key Tank expects as X-Tank-Key (same value as TANK_API_KEY in tervory-tank)
TANK_API_KEY=

# Phase 1 only: one shared tester tenant until Clerk auth lands. A UUID.
WORKSPACE_TENANT_ID=
