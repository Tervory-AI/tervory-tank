{
  "name": "next-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy": "node scripts/deploy-gate.cjs",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "test:visual": "node scripts/require-frames.cjs && playwright test e2e/visual.spec.ts --project=desktop"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/eslintrc": "3.3.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.55.1",
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.23",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "sharp": "0.35.5",
    "basic-ftp": "6.2.1",
    "body-parser": "1.20.9",
    "tmp": "0.2.7",
    "postcss": "8.5.23",
    "playwright": "1.55.1",
    "postcss-selector-parser": "7.1.6",
    "uuid": "11.1.1",
    "zod": "4.6.6"
  }
}
