{
  "name": "next-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/content-check.cjs && next build",
    "deploy": "node scripts/deploy-gate.cjs",
    "start": "next start",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "test:visual": "node scripts/require-frames.cjs && playwright test e2e/visual.spec.ts --project=desktop"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "sharp": "0.35.5",
    "basic-ftp": "6.2.3",
    "body-parser": "1.20.9",
    "tmp": "0.2.7",
    "postcss": "8.5.31",
    "playwright": "1.64.1",
    "postcss-selector-parser": "7.1.7",
    "uuid": "11.1.1",
    "zod": "4.6.7"
  }
}
