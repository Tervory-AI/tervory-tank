# Existing Base room credentials; set through the operator's secret mechanism.
TANK_KEY_BASE=
AGENT_DB_PASSWORD_BASE=
# Exact public HTTPS hosts permitted for Base's browser. Empty means no hosts.
# Compose defaults to the ATF public host pair when this variable is unset.
BASE_ALLOWED_HOSTS=
# BASE_BRAIN_URL and DOCKER_HOST are fixed internal addresses in compose.
# No model/provider key belongs in any Base service.
