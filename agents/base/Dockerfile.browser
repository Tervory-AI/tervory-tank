FROM python:3.12-slim-bookworm@sha256:6a0e06f5ba0b373d051aabd3fffb9b873f27f9a2a3a14bcbe37dee6f0e3bbc70
COPY agents/_chassis/requirements-browser.lock /tmp/requirements-browser.lock
RUN --mount=type=secret,id=system_ca \
    if [ -s /run/secrets/system_ca ]; then \
      export PIP_CERT=/run/secrets/system_ca SSL_CERT_FILE=/run/secrets/system_ca \
        REQUESTS_CA_BUNDLE=/run/secrets/system_ca CURL_CA_BUNDLE=/run/secrets/system_ca \
        NODE_EXTRA_CA_CERTS=/run/secrets/system_ca GIT_SSL_CAINFO=/run/secrets/system_ca; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends chromium=156.0.8078.47-1~deb12u1 ca-certificates=20250419~deb12u2 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --require-hashes --no-cache-dir -r /tmp/requirements-browser.lock \
    && useradd --create-home --uid 1000 browser \
    && mkdir -p /browser-data && chown browser:browser /browser-data
WORKDIR /app
COPY agents/_brain /app/brain
RUN chmod -R a+rX /app/brain
USER browser
CMD ["uvicorn", "brain.browser:app", "--host", "0.0.0.0", "--port", "3000", "--no-access-log", "--no-proxy-headers"]
