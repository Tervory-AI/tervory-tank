FROM mcr.microsoft.com/playwright/python:v1.55.0-noble
RUN pip install --no-cache-dir playwright==1.55.0 fastapi==0.115.6 uvicorn==0.32.1 httpx==0.28.1 \
    && mkdir -p /browser-data && chown pwuser:pwuser /browser-data
WORKDIR /app
COPY agents/_brain /app/brain
USER pwuser
CMD ["uvicorn", "brain.browser:app", "--host", "0.0.0.0", "--port", "3000", "--no-access-log"]
