FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends chromium ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir playwright==1.55.0 pypdf==6.20.1 fastapi==0.115.6 uvicorn==0.32.1 httpx==0.28.1 \
    && useradd --create-home --uid 1000 browser \
    && mkdir -p /browser-data && chown browser:browser /browser-data
WORKDIR /app
COPY agents/_brain /app/brain
RUN chmod -R a+rX /app/brain
USER browser
CMD ["uvicorn", "brain.browser:app", "--host", "0.0.0.0", "--port", "3000", "--no-access-log", "--no-proxy-headers"]
