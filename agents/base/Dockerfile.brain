FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
# Advisory overrides (PR grok/d-advisory-pins): hermes-agent at this commit exact-pins
# certifi 2026.5.20 (PYSEC-2026-4320), PyJWT 2.13.0 (fixed in 2.15.0) and Pillow 12.3.0
# (fixed in 13.0.0; browser-harness also pins 12.3.0), so pip cannot resolve the fixed
# versions alongside it. They are laid over with --no-deps after the hermes install.
# Upstream hermes main ships these same fixed versions (Pillow 13 via a uv override).
ARG HERMES_COMMIT=d923a5eb487a17c0a68801bba9ef0f56c81040a8
COPY agents/_chassis/requirements-brain-build.lock agents/_chassis/requirements-brain.lock /tmp/
RUN --mount=type=secret,id=system_ca \
    if [ -s /run/secrets/system_ca ]; then \
      export PIP_CERT=/run/secrets/system_ca SSL_CERT_FILE=/run/secrets/system_ca \
        REQUESTS_CA_BUNDLE=/run/secrets/system_ca CURL_CA_BUNDLE=/run/secrets/system_ca \
        NODE_EXTRA_CA_CERTS=/run/secrets/system_ca GIT_SSL_CAINFO=/run/secrets/system_ca; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends git=1:2.47.3-0+deb13u1 ca-certificates=20250419+deb13u1 \
    && rm -rf /var/lib/apt/lists/* \
    && git init /opt/hermes && cd /opt/hermes \
    && git remote add origin https://github.com/NousResearch/hermes-agent.git \
    && git fetch --depth 1 origin "$HERMES_COMMIT" && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "$HERMES_COMMIT" \
    && grep -qF "$HERMES_COMMIT.tar.gz" /tmp/requirements-brain.lock \
    && pip install --no-cache-dir --require-hashes -r /tmp/requirements-brain-build.lock \
    && HERMES_NIX_BUILD=1 pip install --no-cache-dir --no-build-isolation --require-hashes -r /tmp/requirements-brain.lock \
    && rm -rf /opt/hermes/.git /opt/hermes/skills /opt/hermes/optional-skills \
    && mkdir -p /opt/empty-skills /data \
    && useradd --create-home --uid 1000 brain && chown brain:brain /data
# The upstream MIT LICENSE is retained in /opt/hermes/LICENSE.
WORKDIR /app
COPY agents/_brain /app/brain
RUN chmod -R a+rX /app/brain
ENV PYTHONPATH=/opt/hermes:/app \
    HERMES_BUNDLED_SKILLS=/opt/empty-skills \
    HERMES_OPTIONAL_SKILLS=/opt/empty-skills \
    PYTHONUNBUFFERED=1
USER brain
CMD ["uvicorn", "brain.service:app", "--host", "0.0.0.0", "--port", "8001", "--no-access-log"]
