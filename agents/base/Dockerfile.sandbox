FROM python:3.12-slim
ARG PYTHON_WASI_SHA256=e99a617738ade87cd263aa46cace7173faa91b5de994499c83e49d132c40bb77
RUN pip install --no-cache-dir fastapi==0.133.1 starlette==1.3.1 uvicorn==0.32.1 wasmtime==49.0.0 \
    && useradd --create-home --uid 1000 sandbox && mkdir /work && chown sandbox:sandbox /work
WORKDIR /app
COPY agents/_brain /app/brain
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
# CPython's PSF licence is retained in the distribution. Only its standard
# library and one run directory are preopened; no socket or host shell exists.
RUN python -c "import hashlib,io,os,urllib.request,zipfile; data=urllib.request.urlopen('https://github.com/brettcannon/cpython-wasi-build/releases/download/v3.13.11/python-3.13.11-wasi_sdk-24.zip').read(); assert hashlib.sha256(data).hexdigest()=='$PYTHON_WASI_SHA256'; zipfile.ZipFile(io.BytesIO(data)).extractall('/opt/python-wasi'); open('/opt/python-wasi/LICENSE','wb').write(urllib.request.urlopen('https://raw.githubusercontent.com/python/cpython/v3.13.11/LICENSE').read())" \
    && python -c "from brain.sandbox_exec import precompile; precompile()" \
    && chmod -R a+rX /app/brain /opt/python-wasi
USER sandbox
CMD ["uvicorn", "brain.sandbox:app", "--host", "0.0.0.0", "--port", "8002", "--no-access-log"]
