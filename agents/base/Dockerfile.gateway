FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
RUN pip install --no-cache-dir fastapi==0.133.1 starlette==1.3.1 uvicorn==0.32.1 httpx==0.28.1 \
    && useradd --create-home gateway
WORKDIR /app
COPY agents/_brain /app/brain
RUN chmod -R a+rX /app/brain
USER gateway
CMD ["uvicorn", "brain.browser_gateway:app", "--host", "0.0.0.0", "--port", "3000", "--no-access-log"]
