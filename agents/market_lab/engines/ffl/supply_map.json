{
  "plan": {
    "supply": [
      {
        "source": "listing_counts",
        "prefix": "count:state:",
        "unit": "listings",
        "per_capita": true,
        "note": "Active licences per state from the ATF monthly lists"
      }
    ],
    "demand": [
      {
        "source": "upload",
        "prefix": "applications:",
        "unit": "applications",
        "note": "Founder per-state licence-application history"
      },
      {
        "source": "check_counts",
        "prefix": "total:",
        "unit": "checks",
        "note": "Monthly FBI NICS background-check counts per state"
      }
    ],
    "population": [
      {
        "source": "census_population",
        "prefix": "population:state:",
        "unit": "people"
      }
    ],
    "costs": [
      {
        "role": "copper",
        "ref": "PCOPPUSDM",
        "feeds_id": "fred_pcoppusdm",
        "adapter": "fred",
        "source": "fred",
        "store": false,
        "unit": "index"
      },
      {
        "role": "zinc",
        "ref": "PZINCUSDM",
        "feeds_id": "fred_pzincusdm",
        "adapter": "fred",
        "source": "fred",
        "store": false,
        "unit": "index"
      },
      {
        "role": "lead",
        "ref": "PLEADUSDM",
        "feeds_id": "fred_pleadusdm",
        "adapter": "fred",
        "source": "fred",
        "store": false,
        "unit": "index"
      },
      {
        "role": "freight",
        "ref": "TSIFRGHT",
        "feeds_id": "fred_tsifrght",
        "adapter": "fred",
        "source": "fred",
        "store": false,
        "unit": "index"
      }
    ],
    "surge": {
      "window": 6,
      "z_threshold": 2.0,
      "pct_threshold": 0.25
    },
    "bindings": {
      "supply": [
        {
          "source": "listing_counts",
          "prefix": "count:state:"
        }
      ],
      "demand": [
        {
          "source": "upload",
          "prefix": "applications:"
        },
        {
          "source": "check_counts",
          "prefix": "total:"
        }
      ],
      "population": [
        {
          "source": "census_population",
          "prefix": "population:state:"
        }
      ],
      "competitors": [
        {
          "source": "competitor",
          "prefix": "competitors:"
        }
      ]
    },
    "response_targets": {
      "increase": 5.0,
      "hold": 3.0,
      "reduce": 1.0
    }
  },
  "warnings": {
    "signals": [
      {
        "source": "port_los_angeles",
        "ref": "teu",
        "label": "Port of Los Angeles container volume"
      },
      {
        "source": "bts_freight",
        "ref": "tsifrght",
        "label": "Freight volume"
      },
      {
        "source": "eia_diesel",
        "label": "Diesel prices"
      },
      {
        "source": "noaa_alerts",
        "label": "Severe weather notices",
        "kind": "notice"
      },
      {
        "source": "legiscan",
        "label": "Legislation",
        "kind": "notice"
      },
      {
        "source": "world_bank_commodities",
        "label": "Commodity prices"
      },
      {
        "source": "port_nynj",
        "ref": "Imports",
        "label": "Loaded container imports, Port of New York and New Jersey"
      }
    ],
    "outcomes": [
      {
        "source": "listing_counts",
        "label": "Licence counts"
      },
      {
        "source": "check_counts",
        "label": "Background-check counts",
        "note": "These are not sales."
      },
      {
        "source": "tiger_price",
        "label": "Watched product prices"
