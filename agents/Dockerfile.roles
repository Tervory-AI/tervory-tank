# One-shot image. Creates agent database roles, then exits.
# Tank does not use this image. asyncpg is the only dependency.
FROM python:3.12-slim@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
WORKDIR /app
COPY _chassis/requirements-roles.lock /tmp/requirements-roles.lock
RUN --mount=type=secret,id=system_ca \
    if [ -s /run/secrets/system_ca ]; then \
      export PIP_CERT=/run/secrets/system_ca SSL_CERT_FILE=/run/secrets/system_ca \
        REQUESTS_CA_BUNDLE=/run/secrets/system_ca CURL_CA_BUNDLE=/run/secrets/system_ca \
        NODE_EXTRA_CA_CERTS=/run/secrets/system_ca GIT_SSL_CAINFO=/run/secrets/system_ca; \
    fi; \
    printf '%s\n' 'asyncpg==0.30.0' > /tmp/roles-constraints.txt \
    && pip install --require-hashes --no-cache-dir -r /tmp/requirements-roles.lock -c /tmp/roles-constraints.txt \
    && useradd --create-home --uid 1000 roles
COPY _chassis/chassis /app/chassis
COPY _chassis/provision_agent_roles.py /app/provision_agent_roles.py
USER roles
CMD ["python", "/app/provision_agent_roles.py"]
