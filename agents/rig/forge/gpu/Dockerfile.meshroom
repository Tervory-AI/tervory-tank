# syntax=docker/dockerfile:1
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04@sha256:cff3a0d82d2c2b47bab252d67fa9b34a20ef4c50781d98501b5c7367ea9afd10
WORKDIR /opt/forge
COPY gpu /opt/forge/gpu
RUN --mount=type=secret,id=system_ca \
    if [ -s /run/secrets/system_ca ]; then \
      export PIP_CERT=/run/secrets/system_ca SSL_CERT_FILE=/run/secrets/system_ca \
        REQUESTS_CA_BUNDLE=/run/secrets/system_ca CURL_CA_BUNDLE=/run/secrets/system_ca \
        NODE_EXTRA_CA_CERTS=/run/secrets/system_ca GIT_SSL_CAINFO=/run/secrets/system_ca; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends python3=3.10.6-1~22.04.1 python3-pip=22.0.2+dfsg-1ubuntu0.7 ca-certificates=20260816ubuntu0.22.04.1 \
      libgl1=1.4.0-1 libglib2.0-0=2.72.4-0ubuntu2.10 libx11-6=2:1.7.5-1ubuntu0.4 libxrender1=1:0.9.10-1build4 libxi6=2:1.8-1build1 libsm6=2:1.2.3-1build2 libice6=2:1.0.10-1build2 libgomp1=12.3.0-1ubuntu1~22.04.3 libfontconfig1=2.13.1-4.2ubuntu5 \
    && python3 -m pip install --no-cache-dir --require-hashes -r gpu/meshroom-requirements.lock \
    && python3 gpu/install_sources.py gpu/meshroom.lock.json \
    && ln -s /usr/bin/python3 /usr/local/bin/python \
    && rm -rf /var/lib/apt/lists/* && useradd --uid 1000 --create-home forge \
    && chmod -R a+rX /opt/forge /opt/meshroom
USER forge
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 QT_QPA_PLATFORM=offscreen
CMD ["python", "/opt/forge/gpu/entrypoint.py", "photogrammetry"]
