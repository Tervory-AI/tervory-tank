# Build from repository root; this image is a worker, never a database server.
FROM python:3.12-slim-trixie@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
WORKDIR /app
# Trixie's pg_dump can read the stack's PostgreSQL 16 databases. age keeps the
# private restore identity off this worker; only a public recipient is needed.
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client age \
    && pip install --no-cache-dir httpx==0.28.1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 backup-worker
COPY --chown=backup-worker:backup-worker agents/_chassis/chassis/__init__.py agents/_chassis/chassis/storage.py /app/agents/_chassis/chassis/
COPY --chown=backup-worker:backup-worker jobs/train/backup.py jobs/train/r2_archive.py /app/jobs/train/
USER backup-worker
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
CMD ["python", "jobs/train/backup.py", "--owner", "uploads", "--nightly"]
