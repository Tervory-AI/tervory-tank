{"name": "csv upload", "input": {"adapter": "csv", "series_id": "upload:orders", "source": "upload", "fetched_at": "2026-10-14T00:00:00+00:00", "text": "date,value\n2024-01-01,10\n2024-02-01,12\n"}, "expected": {"series_id": "upload:orders", "source": "upload", "stored": true, "fetched_at": "2026-10-14T00:00:00+00:00", "points": [{"date": "2024-01-01", "value": 10.0}, {"date": "2024-02-01", "value": 12.0}]}, "tolerance": "exact"}
