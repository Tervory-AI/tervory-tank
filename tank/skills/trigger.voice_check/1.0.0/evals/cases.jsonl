{"name": "empty refused", "input": {"text": ""}, "expected": {"issues": [], "error": "empty text"}, "tolerance": "exact", "must_refuse": true}
{"name": "whitespace refused", "input": {"text": "  "}, "expected": {"issues": [], "error": "empty text"}, "tolerance": "exact", "must_refuse": true}
{"name": "missing refused", "input": {}, "expected": {"issues": [], "error": "empty text"}, "tolerance": "exact", "must_refuse": true}
{"name": "no voice rules", "input": {"text": "The catapult was built with care."}, "expected": {"issues": [], "error": null}, "tolerance": "exact"}
{"name": "banned cat", "input": {"text": "The catapult was built with care. The cat is quiet.", "banned_terms": ["cat"]}, "expected": {"issues": [{"source": "voice", "rule": "banned_term", "offset": 38, "length": 3, "message": "Banned term: cat"}], "error": null}, "tolerance": "exact"}
{"name": "banned boundary", "input": {"text": "The catapult holds a cat.", "banned_terms": ["cat"]}, "expected": {"issues": [{"source": "voice", "rule": "banned_term", "offset": 21, "length": 3, "message": "Banned term: cat"}], "error": null}, "tolerance": "exact"}
{"name": "required missing", "input": {"text": "Hello there.", "required_terms": ["Reliable"]}, "expected": {"issues": [{"source": "voice", "rule": "required_term", "message": "Required term missing: Reliable"}], "error": null}, "tolerance": "exact"}
{"name": "required present", "input": {"text": "Reliable service today.", "required_terms": ["Reliable"]}, "expected": {"issues": [], "error": null}, "tolerance": "exact"}
{"name": "sentence length", "input": {"text": "One two three four five six.", "max_sentence_words": 5}, "expected": {"issues": [{"source": "voice", "rule": "sentence_length", "offset": 0, "message": "Sentence has 6 words; voice limit is 5."}], "error": null}, "tolerance": "exact"}
{"name": "sentence ok", "input": {"text": "One two three.", "max_sentence_words": 5}, "expected": {"issues": [], "error": null}, "tolerance": "exact"}
{"name": "default length ignored", "input": {"text": "w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w w.", "max_sentence_words": 30}, "expected": {"issues": [], "error": null}, "tolerance": "exact"}
{"name": "multi banned", "input": {"text": "Alpha and beta and gamma.", "banned_terms": ["alpha", "gamma"]}, "expected": {"issues": [{"source": "voice", "rule": "banned_term", "offset": 0, "length": 5, "message": "Banned term: alpha"}, {"source": "voice", "rule": "banned_term", "offset": 19, "length": 5, "message": "Banned term: gamma"}], "error": null}, "tolerance": "exact"}
{"name": "multi required", "input": {"text": "Only alpha here.", "required_terms": ["alpha", "beta"]}, "expected": {"issues": [{"source": "voice", "rule": "required_term", "message": "Required term missing: beta"}], "error": null}, "tolerance": "exact"}
{"name": "phrase banned", "input": {"text": "Do not say wrong word here.", "banned_terms": ["wrong word"]}, "expected": {"issues": [{"source": "voice", "rule": "banned_term", "offset": 11, "length": 10, "message": "Banned term: wrong word"}], "error": null}, "tolerance": "exact"}
{"name": "phrase required", "input": {"text": "Say the right phrase please.", "required_terms": ["right phrase"]}, "expected": {"issues": [], "error": null}, "tolerance": "exact"}
{"name": "empty term lists", "input": {"text": "Plain text.", "banned_terms": [], "required_terms": []}, "expected": {"issues": [], "error": null}, "tolerance": "exact"}
{"name": "ignore blank banned", "input": {"text": "Plain text.", "banned_terms": ["", "  "]}, "expected": {"issues": [], "error": null}, "tolerance": "exact"}
{"name": "casefold banned", "input": {"text": "The Brand appears twice: brand.", "banned_terms": ["brand"]}, "expected": {"issues": [{"source": "voice", "rule": "banned_term", "offset": 4, "length": 5, "message": "Banned term: brand"}, {"source": "voice", "rule": "banned_term", "offset": 25, "length": 5, "message": "Banned term: brand"}], "error": null}, "tolerance": "exact"}
{"name": "long limit", "input": {"text": "word word word word word word word word word word.", "max_sentence_words": 8}, "expected": {"issues": [{"source": "voice", "rule": "sentence_length", "offset": 0, "message": "Sentence has 10 words; voice limit is 8."}], "error": null}, "tolerance": "exact"}
{"name": "short limit pass", "input": {"text": "Five words are right here.", "max_sentence_words": 8}, "expected": {"issues": [], "error": null}, "tolerance": "exact"}
{"name": "combined", "input": {"text": "The cat sat. Needed Reliable.", "banned_terms": ["cat"], "required_terms": ["Reliable"], "max_sentence_words": 4}, "expected": {"issues": [{"source": "voice", "rule": "banned_term", "offset": 4, "length": 3, "message": "Banned term: cat"}], "error": null}, "tolerance": "exact"}
{"name": "required with care", "input": {"text": "Built with care today.", "required_terms": ["with care"]}, "expected": {"issues": [], "error": null}, "tolerance": "exact"}
