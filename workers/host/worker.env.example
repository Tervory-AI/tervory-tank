# /etc/tervory-workers/worker.env on the Boston host. Names only in git: never commit a value.
# Owner root, group tervory-workers, mode 0640 (install.sh enforces it). Only root and the
# tervory-workers user can read it. Read by the systemd user unit as EnvironmentFile.
#
# Secrets: fill these on the server, never in git or chat.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
TANK_KEY_WORKERS=
# The GitHub App private key is a separate file with the same rule (root:tervory-workers 0640).
GITHUB_APP_PRIVATE_KEY_FILE=/etc/tervory-workers/github-app.pem
#
# Not secret.
WORKER_LINK=loopback
TANK_URL=http://127.0.0.1:8100
TANK_REGION=us-east
WORKER_PORT=8110
WORKER_MAX_TASKS=1
WORKER_TASK_CPUS=2
WORKER_TASK_MEMORY=4g
WORKER_TASK_TIMEOUT_MINUTES=90
WORKER_POLL_SECONDS=60
WORKER_REPO=Tervory-AI/tervory-tank
WORKER_TENANT_ID=00000000-0000-0000-0000-000000000001
WORKER_TASK_TYPE=reason.brief
