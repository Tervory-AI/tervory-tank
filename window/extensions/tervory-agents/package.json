{
  "name": "tervory-agents",
  "displayName": "Tervory Agents",
  "description": "Background repository tasks through the Tervory worker server",
  "version": "0.1.0",
  "publisher": "tervory",
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./extension.cjs",
  "activationEvents": [
    "onView:tervory.agents"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tervory.agents.start",
        "title": "Start task"
      },
      {
        "command": "tervory.agents.cancel",
        "title": "Cancel",
        "icon": "$(close)"
      },
      {
        "command": "tervory.agents.connect",
        "title": "Connect Tervory"
      },
      {
        "command": "tervory.agents.vault",
        "title": "Save GitHub credential"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "tervory.agents",
          "name": "Agents"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "tervory.agents.cancel",
          "when": "view == tervory.agents && viewItem == tervoryAgent.running",
          "group": "inline"
        }
      ]
    }
  }
}
