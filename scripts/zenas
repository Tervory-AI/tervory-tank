#!/usr/bin/env bash
set -euo pipefail
export PYTHONDONTWRITEBYTECODE=1
cd "$(dirname "$0")/.."
export PYTHONPATH="$PWD:$PWD/tank:$PWD/agents/_chassis:$PWD/vendor/tervory-tank:$PWD/vendor/tervory-tank/tank:$PWD/vendor/tervory-tank/agents/_chassis${PYTHONPATH:+:$PYTHONPATH}"
if [[ -x .venv/bin/python ]]; then zenas_python=.venv/bin/python; else zenas_python=${PYTHON:-python3}; fi
exec "$zenas_python" -m agents.zenas.core.operations "$@"
